# ==============================================================================
# BACKEND SERVER CONFIGURATION (Render Web Service — keep strictly server-side)
# ==============================================================================

# GEMINI_API_KEY: Required for all server-side Gemini AI routes & PDF OCR fallback.
# NEVER prefix with VITE_ or expose in browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides for external deployments (e.g. Render)
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# Server runtime mode
NODE_ENV="development"
PORT="3000"
# Set API_ONLY="true" when deploying backend-only on Render (frontend hosted on Netlify)
API_ONLY="false"

# CORS allowlist (comma-separated origins allowed to call the Render backend API)
ALLOWED_ORIGINS="https://studybuddyaiassistant.netlify.app,http://localhost:3000,http://localhost:5173"

# Upload safety limit in megabytes (default 35)
MAX_UPLOAD_SIZE_MB="35"

# Server-side Supabase Auth verification (validates Bearer JWTs against Supabase /auth/v1/user)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# Optional app URL used for self-referential links / CORS
APP_URL="https://studybuddyaiassistant.netlify.app"

# ==============================================================================
# FRONTEND CONFIGURATION (Netlify Build-Time Variables — VITE_* only)
# ==============================================================================

# URL of your deployed Render backend Web Service (leave empty for local same-origin dev)
VITE_API_BASE_URL=""

# Supabase browser client credentials (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
